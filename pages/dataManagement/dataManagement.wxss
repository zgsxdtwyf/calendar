/* dataManagement.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.back-button {
  font-size: 28rpx;
  color: #3cc51f;
}

.section {
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.section-content {
  padding: 10rpx 0;
}

.info-row {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.info-label {
  color: #666;
  width: 200rpx;
}

.info-value {
  color: #333;
  flex: 1;
}

.button-group {
  display: flex;
  justify-content: space-between;
  margin: 30rpx 0;
}

.primary-button, .warning-button {
  width: 45%;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.primary-button {
  background-color: #3cc51f;
  color: white;
}

.warning-button {
  background-color: #ff9800;
  color: white;
}

.tips {
  background-color: #f5f5f5;
  padding: 15rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.tips-content {
  font-size: 24rpx;
  color: #888;
  display: block;
  line-height: 1.6;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-value {
  display: flex;
  align-items: center;
  color: #666;
}

.arrow {
  margin-left: 10rpx;
  color: #ccc;
}

.warning-section {
  background-color: #fff8e1;
  border-left: 8rpx solid #ffc107;
  padding: 20rpx;
  border-radius: 8rpx;
}

.warning-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff9800;
  display: block;
  margin-bottom: 10rpx;
}

.warning-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 弹窗样式 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.popup-content {
  width: 80%;
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.close-button {
  font-size: 32rpx;
  color: #999;
}

.popup-body {
  padding: 30rpx 20rpx;
}

.picker-view {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

.picker-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #3cc51f;
  margin: 0 20rpx;
}

.popup-footer {
  padding: 20rpx;
  border-top: 1rpx solid #eee;
}

.confirm-button {
  background-color: #3cc51f;
  color: white;
  font-size: 28rpx;
  border-radius: 8rpx;
}