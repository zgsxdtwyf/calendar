.other-month {
  color: #ccc;
}

/* Add styles for the calendar and schedule components here */

/* 确保容器是flex布局，且垂直排列 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh; /* 占据整个视口高度 */
  box-sizing: border-box;
  padding: 20rpx;
  background-color: #f8f8f8;
}

/* 日历头部样式 */
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  flex-shrink: 0; /* 防止头部缩小 */
}

.nav-button {
  padding: 0 20rpx;
  color: #007bff;
}

/* 星期几的样式 */
.weekdays {
  display: flex;
  justify-content: space-around;
  padding: 10rpx 0;
  background-color: #f0f0f0;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0; /* 防止星期几缩小 */
}

.weekdays text {
    width: calc(100% / 7);
    text-align: center;
}

/* 日历网格样式 */
.calendar-grid {
  flex-grow: 1; /* 占据 calendar-swipe-area 内的剩余垂直空间 */
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  /* grid-template-rows: repeat(6, 1fr); /* 假设最多6行 */ 
  /* gap: 1rpx; */
  background-color: #e0e0e0; /* 网格线颜色 */
  border-radius: 10rpx;
  overflow: hidden; /* 确保内容不溢出 */
}
.day {
  display: flex; /* 新增：确保 .day 元素是 flex 容器，以便其内部的 flex 属性生效 */
  text-align: center;
  flex-direction: column; /* Stack date and schedules */
  align-items: center;
  justify-content: flex-start; /* 新增：让日期和日程从单元格顶部开始排列 */
  box-sizing: border-box;
  font-size: 28rpx;
  position: relative; /* Needed for paste popup positioning */
  height: 100%; /* 新增：确保日期格子占据其网格单元格的全部高度 */
  overflow: hidden; /* 新增：隐藏超出日格子的内容，配合内部滚动 */
  background-color: #fff; /* 新增：为每个日期格添加背景色，使其边界更清晰 */
}
/* 新增：当日日期特殊显示样式 */
.day.today {
  border: 2rpx solid #007bff; /* 蓝色边框 */
  background-color: #e6f7ff; /* 浅蓝色背景 */
  border-radius: 10rpx; /* 圆角 */
}

.day.today text {
  color: #007bff; /* 日期文字颜色 */
  font-weight: bold; /* 字体加粗 */
}
.day text {
  margin-bottom: 22rpx; /* Space between date and schedules */
}

.schedule-item-in-day {
  font-size: 20rpx; /* Smaller font for day view */
  color: #fff;
  padding: 2rpx 5rpx 8rpx 8rpx; /* 修改：增加左侧内边距，使文字从圆角后开始显示 */
  margin-bottom: 2rpx;
  border-radius: 4rpx;
  max-width: 100%; /* Prevent overflow */
  max-height: 28rpx;         /* 增加最小高度 */
  border-radius: 10rpx;  
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 90rpx;
  display: flex; /* 新增：使日程条成为 Flex 容器 */
  justify-content: flex-start; /* 新增：内容从左侧开始排列 */
  align-items: center; /* 保持垂直居中 */
  line-height: 24rpx; /* 新增：设置行高，确保文字垂直居中且不被裁剪 */
}

.current-month {
  color: #333;
}

.other-month {
  color: #ccc;
}



/* Popup Styles */
.schedule-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%; /* Full height overlay */
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center; /* 修改：使弹窗在垂直方向上居中 */
  z-index: 999; /* Ensure it's on top */
}

.popup-content {
  background-color: #fff;
  width: 100%;
  max-height: 900rpx; /* 修改：限制内容最大高度，以显示大约8条日程 */
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden; /* Hide overflow if content is too tall */
}

.popup-header {
  display: flex;
  justify-content: space-between; /* Distribute space */
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 32rpx;
  font-weight: bold;
}

.close-button {
  font-size: 40rpx; /* Make it larger */
  color: #999;
  margin-left: 20rpx; /* Space from delete button */
}

/* Add styles for the delete icon */
.delete-icon {
  width: 40rpx; /* Adjust size */
  height: 40rpx; /* Adjust size */
  margin-left: auto; /* Push to the right */
  margin-right: 20rpx; /* Space from close button */
}


.schedule-list {
  flex-grow: 1; /* Allow list to take available space */
  overflow-y: auto; /* Enable scrolling */
  padding: 0 20rpx;
  display: flex; /* 新增：使日程列表成为 Flex 容器 */
  flex-direction: column; /* 新增：使列表项垂直排列 */
  justify-content: flex-start; /* 新增：使列表项从顶部开始排列 */
}

.schedule-item {
  display: flex; /* 新增：使用 Flexbox 布局 */
  align-items: center; /* 新增：垂直居中对齐子项 */
  padding: 15rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #fff;
}

/* 新增：颜色方块样式 */
.color-square {
  width: 24rpx; /* 颜色方块的宽度 */
  height: 24rpx; /* 颜色方块的高度 */
  border-radius: 4rpx; /* 轻微圆角 */
  margin-right: 15rpx; /* 颜色方块与文本之间的间距 */
  flex-shrink: 0; /* 防止颜色方块被压缩 */
}
/* 新增：日程/标签内容容器 */
.schedule-content {
  display: flex;
  flex-direction: column;
  flex-grow: 1; /* 占据剩余空间 */
}

/* 新增：日程/标签标题样式 */
.schedule-title {
  font-size: 32rpx; /* 标题字体大小 */
  color: #333; /* 标题颜色 */
}

/* 新增：日程/标签时间样式 */
.schedule-time {
  font-size: 24rpx; /* 时间字体大小 */
  color: #999; /* 时间颜色 */
  margin-top: 5rpx; /* 与标题的间距 */
}

.no-schedule-message {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.add-schedule-button {
  width: 100rpx;
  height: 100rpx;
  background-color: #007bff;
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 60rpx;
  position: absolute;
  bottom: 40rpx;
  right: 40rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* Create Schedule Form Styles */
.create-schedule-form {
  padding: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-item text {
  width: 150rpx; /* Label width */
  font-size: 28rpx;
  color: #333;
}

.form-item input,
.form-item picker {
  flex-grow: 1;
  border: 1rpx solid #eee;
  padding: 10rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.color-picker {
  display: flex;
  flex-wrap: wrap;
  flex-grow: 1;
}

.color-option {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  border: 2rpx solid transparent; /* Add border for selection */
}

.color-option.selected {
  border-color: #333; /* Highlight selected color */
}

.save-button {
  background-color: #007bff;
  color: #fff;
  text-align: center;
  padding: 20rpx;
  font-size: 32rpx;
  margin: 20rpx;
  border-radius: 8rpx;
}

/* Add styles for the paste popup */
.paste-popup {
  position: fixed;
  width: 150rpx; /* Adjust size */
  background-color: #fff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
  z-index: 1000; /* Higher than schedule popup */
  overflow: hidden;
}

.paste-content {
  display: flex;
  flex-direction: column;
}

.paste-option {
  padding: 15rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #eee;
}

.paste-option:last-child {
  border-bottom: none;
}
/* New styles for Avatar Button and Settings Sidebar */
.avatar-button {
  position: fixed; /* 固定定位，确保在左上角 */
  top: 40rpx; /* 根据实际顶部导航栏高度调整 */
  left: 20rpx; /* 距离左侧的距离 */
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%; /* 圆形头像 */
  background-color: #ccc; /* 默认头像背景色 */
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1001; /* 确保在最上层 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden; /* 确保图片在圆形内 */
}

.avatar-button .avatar-image {
  width: 100%; /* 图片填充按钮 */
  height: 100%;
}

.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000; /* 在侧边栏下方，主内容上方 */
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
}

.sidebar-overlay.show {
  opacity: 1;
  visibility: visible;
}

.settings-sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 70%; /* 侧边栏宽度 */
  height: 100%;
  background-color: #fff;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.2);
  transform: translateX(-100%); /* 初始状态：隐藏在屏幕左侧 */
  transition: transform 0.3s ease-in-out;
  z-index: 1001; /* 确保在遮罩层上方 */
  display: flex;
  flex-direction: column;
}

.settings-sidebar.show {
  transform: translateX(0); /* 显示状态：滑入视图 */
}

.sidebar-header {
  padding: 30rpx 20rpx;
  font-size: 36rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  text-align: center;
}

.sidebar-menu-item {
  padding: 30rpx 20rpx;
  font-size: 32rpx;
  color: #333;
  border-bottom: 1rpx solid #eee;
}

.sidebar-menu-item:active {
  background-color: #f5f5f5; /* 点击时的背景色 */
}

/* 新增：滑动区域样式 */
.calendar-swipe-area {
    flex-grow: 1; /* 占据剩余垂直空间 */
    display: flex; /* 使其成为 flex 容器 */
    flex-direction: column; /* 使子项（weekdays和calendar-grid）垂直堆叠 */
    overflow: hidden; /* 隐藏超出部分，防止滑动时出现滚动条 */
    width: 100%; /* 新增：确保占据父容器的全部宽度 */
}





